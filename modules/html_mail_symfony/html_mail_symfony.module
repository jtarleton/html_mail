<?php

/**
 * @file
 * Sends the html_mail template through Drupal Symfony Mailer.
 *
 * The hooks are implemented in
 * \Drupal\html_mail_symfony\Hook\HtmlMailSymfonyHooks. The functions below
 * only serve Drupal 10.3 to 11.0, which do not discover hook classes.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\html_mail_symfony\Hook\HtmlMailSymfonyHooks;
use Drupal\symfony_mailer\EmailInterface;

/**
 * Implements hook_mail_alter().
 */
#[LegacyHook]
function html_mail_symfony_mail_alter(array &$message): void {
  \Drupal::service(HtmlMailSymfonyHooks::class)->mailAlter($message);
}

/**
 * Implements hook_mailer_init().
 */
#[LegacyHook]
function html_mail_symfony_mailer_init(EmailInterface $email): void {
  \Drupal::service(HtmlMailSymfonyHooks::class)->mailerInit($email);
}

/**
 * Implements hook_form_FORM_ID_alter() for html_mail_settings.
 */
#[LegacyHook]
function html_mail_symfony_form_html_mail_settings_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(HtmlMailSymfonyHooks::class)->formHtmlMailSettingsAlter($form, $form_state);
}
