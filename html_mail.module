<?php

/**
 * @file
 * One themeable HTML template for outgoing email.
 *
 * The hooks are implemented in \Drupal\html_mail\Hook\HtmlMailHooks. The
 * functions below only serve Drupal 10.3 to 11.0, which do not discover hook
 * classes.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\html_mail\Hook\HtmlMailHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function html_mail_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::service(HtmlMailHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_mail().
 */
#[LegacyHook]
function html_mail_mail(string $key, array &$message, array $params): void {
  \Drupal::service(HtmlMailHooks::class)->mail($key, $message, $params);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function html_mail_theme(): array {
  return \Drupal::service(HtmlMailHooks::class)->theme();
}
